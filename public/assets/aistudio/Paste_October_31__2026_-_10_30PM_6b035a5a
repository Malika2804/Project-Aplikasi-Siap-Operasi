  <script>
    const FONT_PRESETS = [
      { id: 'small',  scale: 0.90, label: 'Ukuran Huruf: Kecil (90%)' },
      { id: 'normal', scale: 1.00, label: 'Ukuran Huruf: Normal (100%)' },
      { id: 'large',  scale: 1.15, label: 'Ukuran Huruf: Besar (115%)' },
      { id: 'xlarge', scale: 1.30, label: 'Ukuran Huruf: Sangat Besar (130%)' }
    ];

    let currentFontIndex = 1;

    function applyFontPreset(index) {
      if (index < 0 || index >= FONT_PRESETS.length) return;
      currentFontIndex = index;
      const preset = FONT_PRESETS[currentFontIndex];
      document.documentElement.style.setProperty('--font-scale', preset.scale);
      document.documentElement.setAttribute('data-font-preset', preset.id);
      document.getElementById('fontStatusLabel').innerText = preset.label;
    }

    function increaseFontSize() { if (currentFontIndex < FONT_PRESETS.length - 1) applyFontPreset(currentFontIndex + 1); }
    function decreaseFontSize() { if (currentFontIndex > 0) applyFontPreset(currentFontIndex - 1); }
    function resetFontSize() { applyFontPreset(1); }

    const DEFAULT_VIDEOS = {
      procedure: "https://www.youtube.com/watch?v=F28MGLlpP90",
      prep: "https://www.youtube.com/watch?v=kYJjZ3_7R4U",
      sideeffects: "https://www.youtube.com/watch?v=F3P_7b7pL4w",
      pain: "https://www.youtube.com/watch?v=yQ3D5oI69G8"
    };

    let videoUrls = { ...DEFAULT_VIDEOS };
    let currentSession = {
      id: Date.now(), fullName: '', age: '', gender: 'Perempuan', surgery: '', rmNumber: '',
      checklist: { procedure: false, prep: false, sideeffects: false, pain: false },
      anxietyScore: 3, readinessScore: 8, specificConcerns: '', timestamp: new Date().toISOString()
    };

    let allSessions = [];
    try { allSessions = JSON.parse(localStorage.getItem('siap_operasi_sessions') || '[]'); } catch (e) { allSessions = []; }

    function switchTab(tabId) {
      ['profile', 'checklist', 'evaluation', 'infohub'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.add('hidden');
        document.getElementById(`nav-${t}`).classList.remove('active');
      });
      document.getElementById(`tab-${tabId}`).classList.remove('hidden');
      document.getElementById(`nav-${tabId}`).classList.add('active');
      window.scrollTo(0, 0);
    }

    function setSurgery(val) { document.getElementById('inputSurgery').value = val; }

    function saveProfileAndNext() {
      const name = document.getElementById('inputName').value.trim();
      if (!name) { alert('Mohon isi nama lengkap pasien.'); return; }
      currentSession.fullName = name;
      currentSession.age = document.getElementById('inputAge').value.trim();
      currentSession.gender = document.getElementById('inputGender').value;
      currentSession.surgery = document.getElementById('inputSurgery').value.trim();
      currentSession.rmNumber = document.getElementById('inputRM').value.trim();
      switchTab('checklist');
    }

    function toggleCheck(key) {
      currentSession.checklist[key] = document.getElementById(`check-${key}`).checked;
      updateProgress();
    }

    function updateProgress() {
      const keys = Object.keys(currentSession.checklist);
      const done = keys.filter(k => currentSession.checklist[k]).length;
      const pct = Math.round((done / keys.length) * 100);
      document.getElementById('progressText').innerText = `${done} dari ${keys.length} Domain Selesai`;
      document.getElementById('progressPercent').innerText = `${pct}%`;
    }

    function updateAnxiety(val) {
      document.getElementById('anxietyValue').innerText = `Skor: ${val}`;
      currentSession.anxietyScore = parseInt(val);
    }

    function updateReadiness(val) {
      document.getElementById('readinessValue').innerText = `Skor: ${val}`;
      currentSession.readinessScore = parseInt(val);
    }

    function saveEvaluationRecord() {
      currentSession.specificConcerns = document.getElementById('inputConcerns').value.trim();
      currentSession.timestamp = new Date().toLocaleString('id-ID');
      allSessions.push({ ...currentSession, id: Date.now() });
      try { localStorage.setItem('siap_operasi_sessions', JSON.stringify(allSessions)); } catch (e) {}
      updateSessionBadge();
      alert('Data evaluasi pasien berhasil disimpan!');
      switchTab('infohub');
    }

    function getYoutubeId(url) {
      const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
      return match ? match[1] : null;
    }

    function playVideoByKey(key) {
      const url = videoUrls[key] || DEFAULT_VIDEOS[key];
      const videoId = getYoutubeId(url);
      const titles = {
        procedure: 'Video Prosedur Operasi & Anestesi',
        prep: 'Video Persiapan Pra-Bedah & Puasa',
        sideeffects: 'Video Antisipasi Efek Samping',
        pain: 'Video Manajemen Nyeri & Relaksasi'
      };
      document.getElementById('videoModalTitle').innerText = titles[key] || 'Video Edukasi';
      const iframe = document.getElementById('videoIframe');
      iframe.src = videoId ? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0` : url;
      document.getElementById('btnOpenInYoutube').onclick = () => window.open(url, '_blank');
      document.getElementById('videoModal').classList.add('show');
    }

    function closeVideoModal() {
      document.getElementById('videoIframe').src = '';
      document.getElementById('videoModal').classList.remove('show');
    }

    function openVideoSettings() {
      document.getElementById('customVideoProcedure').value = videoUrls.procedure;
      document.getElementById('customVideoPrep').value = videoUrls.prep;
      document.getElementById('customVideoSideeffects').value = videoUrls.sideeffects;
      document.getElementById('customVideoPain').value = videoUrls.pain;
      document.getElementById('videoSettingsModal').classList.add('show');
    }

    function closeVideoSettings() { document.getElementById('videoSettingsModal').classList.remove('show'); }

    function saveCustomVideoUrls() {
      videoUrls.procedure = document.getElementById('customVideoProcedure').value.trim() || DEFAULT_VIDEOS.procedure;
      videoUrls.prep = document.getElementById('customVideoPrep').value.trim() || DEFAULT_VIDEOS.prep;
      videoUrls.sideeffects = document.getElementById('customVideoSideeffects').value.trim() || DEFAULT_VIDEOS.sideeffects;
      videoUrls.pain = document.getElementById('customVideoPain').value.trim() || DEFAULT_VIDEOS.pain;
      try { localStorage.setItem('siap_operasi_videos', JSON.stringify(videoUrls)); } catch (e) {}
      alert('Tautan video edukasi berhasil disimpan!');
      closeVideoSettings();
    }

    function resetVideoUrls() {
      videoUrls = { ...DEFAULT_VIDEOS };
      try { localStorage.removeItem('siap_operasi_videos'); } catch (e) {}
      openVideoSettings();
      alert('Link video direset ke default.');
    }

    function openBreathingModal() { document.getElementById('breathingModal').classList.add('show'); }
    function closeBreathingModal() { document.getElementById('breathingModal').classList.remove('show'); }
    function openResearchModal() { renderRecords(); document.getElementById('researchModal').classList.add('show'); }
    function closeResearchModal() { document.getElementById('researchModal').classList.remove('show'); }

    function updateSessionBadge() {
      const badge = document.getElementById('sessionBadge');
      if (allSessions.length > 0) {
        badge.innerText = allSessions.length;
        badge.classList.remove('hidden');
      } else { badge.classList.add('hidden'); }
    }

    function renderRecords() {
      const countEl = document.getElementById('recordCount');
      const listEl = document.getElementById('recordsList');
      countEl.innerText = allSessions.length;
      if (allSessions.length === 0) {
        listEl.innerHTML = '<div class="section-subtitle" style="text-align: center; padding: 20px;">Belum ada data pasien tersimpan.</div>';
        return;
      }
      listEl.innerHTML = allSessions.map(s => `
        <div class="record-item">
          <div style="display: flex; justify-content: space-between; font-weight: 700;">
            <span>${s.fullName} (${s.age} th, ${s.gender})</span>
            <span style="color: var(--teal);">Kesiapan: ${s.readinessScore}/10 | Cemas: ${s.anxietyScore}/10</span>
          </div>
          <div style="color: var(--slate-600); margin-top: 3px;">${s.surgery} • RM: ${s.rmNumber || '-'}</div>
        </div>
      `).join('');
    }

    function exportCSV() {
      if (allSessions.length === 0) { alert('Belum ada data untuk diekspor.'); return; }
      const headers = ['ID', 'Nama Lengkap', 'Usia', 'Gender', 'Tindakan Operasi', 'No RM', 'Skor Kecemasan', 'Skor Kesiapan', 'Kekhawatiran', 'Waktu'];
      const rows = allSessions.map(s => [s.id, `"${s.fullName}"`, s.age, s.gender, `"${s.surgery}"`, `"${s.rmNumber}"`, s.anxietyScore, s.readinessScore, `"${(s.specificConcerns || '').replace(/"/g, '""')}"`, `"${s.timestamp}"`]);
      const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', `Rekap_Data_SiapOperasi_${Date.now()}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function clearAllData() {
      if (confirm('Hapus seluruh riwayat evaluasi pasien di perangkat ini?')) {
        allSessions = [];
        try { localStorage.removeItem('siap_operasi_sessions'); } catch (e) {}
        renderRecords();
        updateSessionBadge();
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      updateSessionBadge();
      applyFontPreset(1);
      try {
        const savedVideos = localStorage.getItem('siap_operasi_videos');
        if (savedVideos) videoUrls = { ...DEFAULT_VIDEOS, ...JSON.parse(savedVideos) };
      } catch (e) {}
    });
  </script>
</body>
</html>